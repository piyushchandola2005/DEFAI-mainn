# Solana RPC (mainnet-beta recommended for memecoins). Use a dedicated provider in production.
NEXT_PUBLIC_SOLANA_RPC_URL=

# Optional: devnet | mainnet default when RPC URL is omitted is inferred from this.
NEXT_PUBLIC_SOLANA_NETWORK=

# External trading bot / automation UI (shown as link on /home).
NEXT_PUBLIC_TRADING_BOT_URL=

# Optional: AI chat with OpenAI (server-side).
OPENAI_API_KEY=

# Optional: local LLM.
OLLAMA_URL=

# Optional: price conversion in chat tools.
CRYPTOCOMPARE_API_KEY=

# BirdEye API key for token CA/mint insights in chat.
BIRDEYE_API_KEY=
